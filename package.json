{
  "name": "cypress-network-chaos",
  "version": "1.0.0",
  "description": "Inject slow networks, failures, dropped requests, timeouts and offline conditions into Cypress tests with one intent-level line. Presets, seeded determinism, a global chaos mode and per-spec reporting.",
  "keywords": [
    "cypress",
    "cypress-plugin",
    "network",
    "chaos",
    "chaos-engineering",
    "resilience",
    "testing",
    "throttle",
    "offline",
    "flaky",
    "intercept",
    "slow-network"
  ],
  "license": "MIT",
  "author": "SnehalP75",
  "repository": {
    "type": "git",
    "url": "https://github.com/SnehalP75/cypress-network-chaos.git"
  },
  "homepage": "https://github.com/SnehalP75/cypress-network-chaos#readme",
  "bugs": {
    "url": "https://github.com/SnehalP75/cypress-network-chaos/issues"
  },
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "typesVersions": {
    "*": {
      "plugin": [
        "dist/plugin.d.ts"
      ],
      "commands": [
        "dist/commands.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./commands": {
      "types": "./dist/commands.d.ts",
      "default": "./dist/commands.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:example": "cypress run --project example"
  },
  "peerDependencies": {
    "cypress": ">=12.0.0"
  },
  "devDependencies": {
    "cypress": "^13.15.0",
    "rimraf": "^5.0.10",
    "typescript": "^5.6.3"
  },
  "allowScripts": {
    "cypress@13.17.0": true
  }
}
